/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN

/*.html
  Cache-Control: public, max-age=300, must-revalidate

/assets/*
  Cache-Control: public, max-age=604800, immutable

# css and js URLs carry a content hash (see _build/shell.mjs), so they can be cached hard
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# The self-removing service worker (see public/sw.js). Never cached, so a browser
# holding the stray Pure Alacrity worker picks it up on its very next visit.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Content-Type: application/javascript; charset=utf-8
